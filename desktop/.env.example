# Read-only master roots. Semicolon-separated list of `label=path[|kind]`.
# Kind defaults to `digital`; `|scan` opts a root into scan-only handling
# (scan_batch/sequence, back detection, rescan detection, folder-name album);
# `|contrib` opts a root into append-only contribution handling (creation
# permitted ONLY under <root>/_incoming/<contribution_id>/ during a Sync
# pull; committed subfolders + the root itself must be read-only).
# Labels must match [a-z0-9_]+ and become `photos.source_root`. Add roots as
# they appear; ingest, guard, and manifests iterate whatever is listed here.
MASTER_ROOTS=photos=D:\Photos;scans=D:\Scanned Photos|scan;contrib=D:\Contributed|contrib

# Writable working set. Regenerable from the masters at any time.
WORKING_DIR=C:\PhotoArchive\working
QUARANTINE_DIR=C:\PhotoArchive\quarantine
MANUAL_FIX_DIR=C:\PhotoArchive\manual-fix
THUMBS_DIR=C:\PhotoArchive\thumbs

# Local Postgres. Password must be URL-encoded if it contains @, :, /, ?, #, [, ], !, $, &, ', (, ), *, +, ,, ;, =, %, ^, {, }, |, `, or space.
DATABASE_URL=postgresql://photo_user:CHANGEME@localhost:5432/photoorg

# Mac mini inference service on the LAN.
INFERENCE_URL=http://mac-mini.local:8500
INFERENCE_TOKEN=CHANGEME

# Web API (this laptop for dev; VM for prod).
WEB_API_URL=http://localhost:8090
WEB_API_TOKEN=CHANGEME

# Face embeddings are ~2 KB each. Off by default — turn on when the web
# needs them (Phase 10+ web-side match suggestions).
SYNC_FACE_EMBEDDINGS=false

# Dedupe thresholds (Phase 4). Two photos are candidates when either the
# pHash or dHash Hamming distance is at or below its threshold.
# 256-bit hashes, so the maximum possible distance is 256.
DEDUPE_PHASH_MAX=10
DEDUPE_DHASH_MAX=10

# Faces clustering (Phase 6). Average-linkage cosine-distance threshold for
# grouping unlabelled face embeddings into clusters for bulk labelling.
FACE_CLUSTER_DIST=0.45

# Face quality gate (Phase 6 fix-up 2). Faces below either threshold are
# excluded from clustering and reference-set means (kept as rows, visible
# via the Faces mode's "Include low-quality" toggle). These stop small
# blurry crops from chaining half the archive into one giant cluster.
FACE_MIN_SCORE=0.7
FACE_MIN_PX=40

# Recursive split cap. Any cluster larger than this is re-clustered on
# its own members at a tighter threshold (× 0.8 per level).
FACE_MAX_CLUSTER=300

# --- Cleanup (Phase 7) -----------------------------------------------------
# Proposal previews, the on-demand full-resolution renders, the split staging
# area, remote-enhance uploads/results, and the run reports (_report/).
# Kept-forever previous working copies live in WORKING_DIR/_versions/.
CLEANUP_DIR=C:\PhotoArchive\cleanup

# Analysis runs on a downscale of this long edge; ops are applied at full
# resolution. 2000 px is enough to find a print edge on a 300-1200 DPI scan.
CLEANUP_ANALYSE_EDGE=2000

# Print detection. Below MIN_PRINT_FRAC of the scan, or outside MAX_ASPECT
# (long/short), the analyser marks needs_manual rather than guessing.
CLEANUP_MIN_PRINT_FRAC=0.40
CLEANUP_MAX_ASPECT=3.0

# Deskew. Under DESKEW_MIN_DEG is scanner noise and is skipped; over
# MAX_DESKEW_DEG is not a scanner slip and becomes needs_manual. The face-box
# transform preserves box size, which is only honest for small angles.
CLEANUP_DESKEW_MIN_DEG=0.3
CLEANUP_MAX_DESKEW_DEG=15.0

# Crop. Skipped when it would remove less than CROP_MIN_FRAC of the area.
# The inset scales with resolution: this many pixels at 300 DPI, so 16 px at
# 1200 DPI. Unknown DPI uses the value as-is.
CLEANUP_CROP_MIN_FRAC=0.01
CLEANUP_CROP_INSET_PX_AT_300=4

# Multi-print split: a component must cover this much of the scan and be this
# rectangular (component area / minAreaRect area) to count as a print.
CLEANUP_SPLIT_MIN_FRAC=0.12
CLEANUP_SPLIT_RECTANGULARITY=0.80

# Colour cast, measured as Lab a/b distance from neutral on the print's
# *near-neutral* mid-tones: the least-colourful CLEANUP_CAST_NEUTRAL_PCT per
# cent of them. An age cast shifts the paper itself, greys included, while
# scene colour lives in the saturated pixels — so measuring over every
# mid-tone (plain grey-world) reads a lawn or a warm indoor shot as a cast and
# "corrects" it into the opposite one. On batches 1-5 grey-world fired on 270
# of 444 scans (median magnitude 14.2) against 168 (6.4) for this estimator,
# and 152 of those 270 were overstated more than twofold. Set to 100 to get
# plain grey-world back.
CLEANUP_CAST_NEUTRAL_PCT=40
CLEANUP_CAST_MIN=6.0
CLEANUP_MONO_CHROMA_MAX=12.0
CLEANUP_SEPIA_HUE_VAR_MAX=0.05

# Levels / fade. Dynamic range (p99.5 - p0.5) below this fraction of full
# scale is a faded print; SCURVE is how much smoothstep rides along with the
# percentile stretch (0 = pure linear).
CLEANUP_CONTRAST_LOW=0.72
CLEANUP_SCURVE=0.12

# Remote enhance. `null` (default) disables the E key with a tooltip; `claid`
# needs CLAID_API_KEY (see GC.md). Nothing here is used until a key is set.
CLEANUP_REMOTE_PROVIDER=null
CLAID_API_KEY=
CLAID_BASE_URL=https://api.claid.ai
CLAID_COST_PER_OP_USD=0.03
