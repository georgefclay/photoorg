#------------------------------------------------------------------------------
# exiftool user config: the `photoarchive` XMP namespace (Phase 13).
#
# Passed with `-config` by modes/metadata/exiftool.py. These are the fields a
# file found loose on a disk carries so it can be matched back to the archive
# and its print found on the shelf. The URI is permanent: changing it orphans
# every file already written.
#------------------------------------------------------------------------------
%Image::ExifTool::UserDefined = (
    'Image::ExifTool::XMP::Main' => {
        photoarchive => {
            SubDirectory => {
                TagTable => 'Image::ExifTool::UserDefined::photoarchive',
            },
        },
    },
);

%Image::ExifTool::UserDefined::photoarchive = (
    GROUPS    => { 0 => 'XMP', 1 => 'XMP-photoarchive', 2 => 'Image' },
    NAMESPACE => { 'photoarchive' => 'https://cyberdinosaurs.com/ns/photoarchive/1.0/' },
    WRITABLE  => 'string',
    PhotoId        => { },
    MasterSha256   => { },
    ScanLocator    => { },
    PhysicalRef    => { },
    SourceFolder   => { },
    SourceFilename => { },
    PayloadHash    => { },
    # Which EXIF fields this archive wrote (not the camera), so a later write
    # may clear or change them. A list: DateTimeOriginal, GPS.
    WroteExif      => { List => 'Bag' },
);

1;  # end
