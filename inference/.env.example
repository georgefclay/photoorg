# Inference service — copy to .env and fill in. Never commit .env.

INFERENCE_HOST=0.0.0.0
INFERENCE_PORT=8500
INFERENCE_TOKEN=CHANGEME
VLM_MODEL=mlx-community/Qwen3-VL-8B-Instruct-4bit
FACE_MODEL=buffalo_l
MAX_IMAGE_EDGE=1536
LOG_DIR=./logs

# Shared folder for the `path` request variant and for the batch inbox.
# Empty disables both: every `path` request is refused with 400 and callers must
# use a multipart upload. Paths are resolved and must land inside this root.
# Uploaded batch inputs live in SHARED_ROOT/inbox/{job_name}/{ref}.jpg
SHARED_ROOT=

# InsightFace detector input size. Larger finds smaller faces in group scans
# at the cost of speed.
FACE_DET_SIZE=1024

# Longest edge per endpoint, overriding MAX_IMAGE_EDGE. Image tokens dominate
# cost, so this is the throughput lever. Descriptive work reads fine at 1024;
# handwriting and small faces need 1536.
MAX_IMAGE_EDGE_OVERRIDES=classify=1024;describe=1024;estimate-date=1024

# VLM generation. temperature 0 keeps a re-run reproducible.
VLM_MAX_TOKENS=768
VLM_TEMPERATURE=0.0

# Per-request ceiling in seconds. A batch applies it per item. The clock covers
# generation only, never the wait for the model.
REQUEST_TIMEOUT_S=120

# When unattended batches stand down, local time, ";"-separated. The batch
# finishes the item in flight and sleeps through the window; interactive
# requests are never affected. Empty means never.
BATCH_BLACKOUT=Tue 04:30-07:30;Fri 04:30-07:30

# Batches also pause while the machine has less than this much RAM free.
BATCH_MIN_FREE_GB=1.0
BATCH_PAUSE_POLL_S=60

# --- M6 swap (2026-09-22) -------------------------------------------------
# Moving to the 32 GB M6 is this one line, then restart the LaunchAgent:
# VLM_MODEL=mlx-community/Qwen3-VL-8B-Instruct-8bit
# or the 32B 4-bit variant if it fits:
# VLM_MODEL=mlx-community/Qwen3-VL-32B-Instruct-4bit
