PORT=8090
NODE_ENV=development
BASE_URL=http://localhost:8090

# Local Postgres. URL-encode any special characters in the password.
DATABASE_URL=postgresql://photo_user:CHANGEME@localhost:5432/photoorg
# Separate DB used by `npm test`. Must not equal DATABASE_URL. Shares the
# `photoorg_test` DB that `shared/` also uses — `npm run test:setup` rolls it
# down and back up before each run, so nothing there is precious.
TEST_DATABASE_URL=postgresql://photo_user:CHANGEME@localhost:5432/photoorg_test

SESSION_SECRET=CHANGEME

# Postmark. Leave blank in dev to use the dev-log fallback.
POSTMARK_API_KEY=
POSTMARK_FROM_EMAIL=

ADMIN_EMAIL=georgefclay@gmail.com

# Shared token the desktop app presents on sync endpoints.
SERVICE_TOKEN=CHANGEME

# Where the working copies live on this host.
PHOTO_DIR=C:\PhotoArchive\working
