<%- include('partials/head', { title: 'Sign in' }) %>
<h1>Sign in</h1>
<p>Enter your email. If you have access, we'll send you a one-time sign-in link.</p>

<% if (error) { %>
  <div class="notice error"><%= error %></div>
<% } %>

<form method="post" action="/login" class="card" autocomplete="off">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
  <div class="honeypot" aria-hidden="true">
    <label>Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
  </div>
  <div class="field">
    <label for="email">Email</label>
    <input id="email" name="email" type="email" required value="<%= values.email %>" />
  </div>
  <div class="actions">
    <button class="button" type="submit">Send sign-in link</button>
    <a class="button secondary" href="/request-access">Request access instead</a>
  </div>
</form>
<%- include('partials/foot') %>
