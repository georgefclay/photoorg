<% page.title = 'Uploads to review'; page.nav = 'admin'; page.wide = true; page.css.push('/css/admin.css'); page.js.push('/js/admin.js') %>
<%
function mb(n) { return n == null ? '' : n >= 1048576 ? (n / 1048576).toFixed(1) + ' MB' : Math.max(1, Math.round(n / 1024)) + ' KB'; }
%>
<%- include('_head', { title: 'Uploads to review', sub: isAdmin
  ? 'Approved files are pulled into the archive by desktop Sync. Rejected files stay on the server; nothing is deleted.'
  : 'Approving adds a photo to your group only. Rejecting removes your group from the upload; other groups decide for themselves.' }) %>

<nav class="tabs" aria-label="Status">
  <% Object.keys(filters).forEach(function (k) { %>
    <a href="/admin/contributions?status=<%= k %>" <%- k === filter ? 'aria-current="page"' : '' %>><%= filters[k] %></a>
  <% }) %>
</nav>

<% if (!items.length) { %>
  <%- include('../partials/empty', {
    icon: 'upload',
    title: filter === 'review' ? 'Nothing to review' : 'No uploads here',
    text: filter === 'review' ? 'When family members upload photos they will appear here.' : 'Try another status.',
  }) %>
<% } else { %>
<div class="contrib-list" <%- isAdmin ? 'data-admin' : '' %>>
  <% items.forEach(function (c) { %>
  <section class="card contrib" id="c<%= c.id %>" data-contribution="<%= c.id %>">
    <header class="contrib-head">
      <div>
        <h2><%= c.uploader %> <span class="muted small-text">· <%= fmt.plural(c.counts.total, 'file') %> · <%= fmt.relTime(c.created_at) %></span></h2>
        <p class="chips">
          <% if (!c.targets.length) { %><span class="chip warn">No group chosen</span><% } %>
          <% c.targets.forEach(function (g) { %><span class="chip <%= g.mine ? 'accent' : '' %>"><%= g.name %></span><% }) %>
          <span class="chip status-<%= c.status %>"><%= c.status %></span>
          <% if (c.counts.dups) { %><span class="chip warn"><%= fmt.plural(c.counts.dups, 'possible duplicate') %></span><% } %>
          <% if (c.pulled_at) { %><span class="chip">pulled to desktop</span><% } %>
        </p>
        <% if (c.note) { %><p class="evidence">“<%= c.note %>”</p><% } %>
        <% if (!c.finished_at && c.status === 'pending') { %><p class="muted small-text">Upload may still be in progress.</p><% } %>
      </div>
      <% if (isAdmin && c.counts.pending) { %>
      <div class="actions batch-actions">
        <button type="button" class="btn" data-act="approve-all">Approve all <%= c.counts.pending %></button>
        <button type="button" class="btn secondary" data-act="reject-all">Reject all</button>
      </div>
      <% } %>
    </header>
    <ul class="file-grid">
      <% c.files.forEach(function (f) { %>
      <li class="file status-<%= f.status %>" data-file="<%= f.id %>">
        <span class="file-thumb">
          <% if (f.is_video || !(f.mime || '').startsWith('image/')) { %>
            <span class="noprev"><%- include('../partials/icon', { name: 'camera' }) %><%= f.is_video ? 'Video' : 'No preview' %></span>
          <% } else { %>
            <img src="/media/contrib/<%= f.id %>" alt="<%= f.original_filename %>" loading="lazy" data-fallback="No preview">
          <% } %>
        </span>
        <span class="file-name" title="<%= f.original_filename %>"><%= f.original_filename %></span>
        <span class="muted small-text"><%= mb(f.size) %><%= f.width ? ` · ${f.width}×${f.height}` : '' %><%= f.exif_taken_at ? ` · ${new Date(f.exif_taken_at).toISOString().slice(0, 10)}` : '' %></span>
        <% if (f.duplicate_of_photo_id) { %>
          <% if (f.dup_kind === 'exact') { %>
            <a class="chip warn dup" href="/photos/<%= f.duplicate_of_photo_id %>">Exact copy of #<%= f.duplicate_of_photo_id %></a>
          <% } else { %>
            <a class="chip warn dup" href="/photos/<%= f.duplicate_of_photo_id %>">Looks like #<%= f.duplicate_of_photo_id %> (distance <%= f.duplicate_distance %>)</a>
          <% } %>
        <% } %>
        <span class="file-status" role="status"><%= f.status === 'pending' ? '' : f.status %><%= f.status === 'approved' && f.approved_groups.length ? ' → ' + f.approved_groups.join(', ') : '' %></span>
        <% if (f.status === 'pending') { %>
        <span class="file-actions">
          <button type="button" class="btn small" data-act="approve" aria-label="Approve <%= f.original_filename %>">Approve</button>
          <button type="button" class="btn small secondary" data-act="reject" aria-label="Reject <%= f.original_filename %>">Reject</button>
        </span>
        <% } %>
      </li>
      <% }) %>
    </ul>
  </section>
  <% }) %>
</div>
<div class="pager">
  <% if (cursor) { %><a class="btn ghost" href="<%= firstUrl %>">Newest</a><% } %>
  <% if (nextUrl) { %><a class="btn secondary" href="<%= nextUrl %>">Older</a><% } %>
</div>
<% } %>
