<%- include('../partials/head', { title: 'Users' }) %>
<h1>Users</h1>

<% if (!users.length) { %>
  <p class="muted">No users yet.</p>
<% } else { %>
  <table class="data">
    <thead>
      <tr>
        <th>Email</th>
        <th>Name</th>
        <th>Role</th>
        <th>Status</th>
        <th>Last login</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% users.forEach(function (u) { %>
        <tr>
          <td><%= u.email %></td>
          <td><%= u.display_name || '' %></td>
          <td>
            <span class="pill <%= u.role === 'admin' ? 'admin' : '' %>"><%= u.role %></span>
          </td>
          <td>
            <span class="pill <%= u.status %>"><%= u.status %></span>
          </td>
          <td><%= u.last_login_at ? new Date(u.last_login_at).toISOString().slice(0, 10) : '' %></td>
          <td>
            <% if (u.status === 'active') { %>
              <form method="post" action="/admin/users/<%= u.id %>/suspend" style="display:inline">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <button class="button danger" type="submit">Suspend</button>
              </form>
            <% } else { %>
              <form method="post" action="/admin/users/<%= u.id %>/reactivate" style="display:inline">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <button class="button" type="submit">Reactivate</button>
              </form>
            <% } %>
            <% if (u.role === 'contributor') { %>
              <form method="post" action="/admin/users/<%= u.id %>/promote" style="display:inline">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <button class="button secondary" type="submit">Promote</button>
              </form>
            <% } else { %>
              <form method="post" action="/admin/users/<%= u.id %>/demote" style="display:inline">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <button class="button secondary" type="submit">Demote</button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
<% } %>
<%- include('../partials/foot') %>
