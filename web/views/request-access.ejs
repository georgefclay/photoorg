<%- include('partials/head', { title: 'Request access' }) %>
<h1>Request access</h1>
<p>The archive is invite-only. Fill this out and George will get back to you.</p>

<% if (error) { %>
  <div class="notice error"><%= error %></div>
<% } %>

<form method="post" action="/request-access" class="card" autocomplete="off">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
  <div class="honeypot" aria-hidden="true">
    <label>Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
  </div>

  <div class="field">
    <label for="email">Your email</label>
    <input id="email" name="email" type="email" required value="<%= values.email %>" />
  </div>
  <div class="field">
    <label for="display_name">What should we call you? <span class="muted">(optional)</span></label>
    <input id="display_name" name="display_name" type="text" value="<%= values.display_name %>" />
  </div>
  <div class="field">
    <label for="message">Anything you want to say? <span class="muted">(optional)</span></label>
    <textarea id="message" name="message"><%= values.message %></textarea>
  </div>
  <div class="actions">
    <button type="submit" class="button">Request access</button>
    <a class="button secondary" href="/">Cancel</a>
  </div>
</form>
<%- include('partials/foot') %>
