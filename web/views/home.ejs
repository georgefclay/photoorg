<%- include('partials/head', { title: 'Home' }) %>
<% if (locals.user) { %>
  <h1>Welcome, <%= user.display_name || user.email %></h1>
  <p class="muted">The archive is coming soon. Uploads, browsing, and search will land in the next phases.</p>
<% } else { %>
  <h1>Photo Archive</h1>
  <p>This is a private family photo archive. If someone has invited you, sign in below. Otherwise you can ask for access.</p>
  <div class="actions">
    <a class="button" href="/login">Sign in</a>
    <a class="button secondary" href="/request-access">Request access</a>
  </div>
<% } %>
<%- include('partials/foot') %>
