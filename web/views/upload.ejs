<%
page.title = 'Upload photos';
page.nav = 'upload';
page.css.push('/css/upload.css');
page.js.push('/js/upload.js');
%>
<div class="page-head">
  <h1>Upload photos</h1>
  <a class="back-link" href="/upload/mine">My uploads <%- include('partials/icon', { name: 'right' }) %></a>
</div>

<p class="notice info up-private">
  <strong>Your photos stay private until they're approved.</strong>
  Only you and the people who look after the archive can see them until then.
  Family photos only, please.
</p>

<p class="muted up-loading" data-loading><span class="spinner" aria-hidden="true"></span> Getting the uploader ready…</p>
<noscript>
  <style>.up-loading { display: none; }</style>
  <p class="notice error">Uploading needs JavaScript. Please turn it on in your browser settings, or ask George to add the photos for you.</p>
</noscript>

<form id="upload-form" class="up-form" data-upload novalidate hidden>
  <fieldset class="up-groups">
    <legend>Who should see them once approved?</legend>
    <% if (!groups.length) { %>
      <p class="muted small-text">You're not in a group yet, so the admin will decide where these go.</p>
    <% } else { %>
      <% groups.forEach(function (g) { %>
        <label class="check">
          <input type="checkbox" name="group_ids" value="<%= g.id %>" <%= preselect === g.id ? 'checked' : '' %>>
          <span><%= g.name %></span>
        </label>
      <% }) %>
      <p class="muted small-text"><%= groups.length === 1 ? '' : 'Tick one or more. ' %>Leave them all unticked and the admin will decide.</p>
    <% } %>
  </fieldset>

  <div class="field">
    <label for="up-note">Note <span class="muted">(optional)</span></label>
    <textarea id="up-note" name="note" maxlength="1000" rows="2" placeholder="e.g. Grandad's fishing trip, summer 1962"></textarea>
  </div>

  <div class="up-pickers">
    <span class="up-pick up-camera">
      <input id="up-camera" class="sr-only" type="file" accept="image/*" capture="environment" data-pick>
      <label class="btn up-big" for="up-camera"><%- include('partials/icon', { name: 'camera' }) %> Take a photo</label>
    </span>
    <span class="up-pick">
      <input id="up-files" class="sr-only" type="file" accept="image/*,video/*" multiple data-pick>
      <label class="btn up-big" for="up-files"><%- include('partials/icon', { name: 'photos' }) %> Choose photos</label>
    </span>
    <span class="up-pick up-folder">
      <input id="up-folder" class="sr-only" type="file" webkitdirectory directory multiple data-pick>
      <label class="btn secondary up-big" for="up-folder"><%- include('partials/icon', { name: 'folder' }) %> Choose a folder</label>
    </span>
  </div>

  <div class="up-drop" data-drop hidden>
    <%- include('partials/icon', { name: 'upload' }) %>
    <p><strong>Drop photos or folders here</strong></p>
  </div>

  <div class="up-status" role="status" aria-live="polite" data-status></div>

  <ul class="up-list" data-list aria-label="Files to send"></ul>

  <div class="up-bar" data-bar hidden>
    <p class="up-count" data-count></p>
    <div class="actions">
      <button type="submit" class="btn" data-send>Send</button>
      <button type="button" class="btn secondary" data-finish hidden>Finish</button>
      <button type="button" class="btn ghost" data-clear>Clear list</button>
    </div>
  </div>
</form>

<section class="card up-done" data-done hidden tabindex="-1">
  <h2><%- include('partials/icon', { name: 'check' }) %> <span data-done-title>All sent — thank you!</span></h2>
  <p data-done-text></p>
  <div class="actions">
    <a class="btn" href="/upload/mine">See my uploads</a>
    <button type="button" class="btn secondary" data-more>Send more photos</button>
  </div>
</section>
