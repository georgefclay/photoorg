<!doctype html>
<html>
  <body style="font-family: system-ui, -apple-system, sans-serif; color:#1c1917;">
    <p>Sign in to the Photo Archive:</p>
    <p>
      <a href="<%= signInUrl %>" style="display:inline-block;padding:12px 22px;background:#6d28d9;color:#fff;text-decoration:none;border-radius:6px;font-weight:600;">Sign in</a>
    </p>
    <p style="color:#57534e;">
      The link is good for 15 minutes and can only be used once.
    </p>
    <p style="color:#57534e;font-size:0.9em;">
      If the button doesn't work, paste this into your browser:<br />
      <%= signInUrl %>
    </p>
  </body>
</html>
