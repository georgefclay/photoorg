{
  "name": "photoarchive-web",
  "version": "0.0.1",
  "private": true,
  "description": "Family photo archive web app (Express + EJS + Postgres)",
  "main": "server.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
