# DB the migrations run against. URL-encode any special characters in the password.
DATABASE_URL=postgresql://photo_user:CHANGEME@localhost:5432/photoorg

# Separate DB used by `npm test` (smoke test). The test refuses to run if this
# equals DATABASE_URL. Create it once:
#   createdb -U postgres -O photo_user photoorg_test
TEST_DATABASE_URL=postgresql://photo_user:CHANGEME@localhost:5432/photoorg_test
